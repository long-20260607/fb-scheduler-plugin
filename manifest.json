{
  "manifest_version": 3,
  "name": "Facebook 定时发布助手",
  "version": "1.0.5",
  "description": "自动设置 Facebook 视频的定时发布时间",
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://business.facebook.com/*",
    "https://hizynzkovnnugjedqpuw.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://business.facebook.com/latest/bulk_upload_composer*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "world":"MAIN"
    }
  ]
}

